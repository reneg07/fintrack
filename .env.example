# ==============================================================================
# FinTrack — Variables de Entorno (Plantilla Documentada)
# ==============================================================================
# Copia este archivo como `.env.local` y completa los valores reales en Fase 03.
# NUNCA incluyas credenciales reales en este archivo ni en el repositorio Git.
# NUNCA utilices la clave `service_role` de Supabase en el código de aplicación.
# ==============================================================================

# URL pública del proyecto en Supabase (Project Settings -> API -> Project URL)
# Ejemplo: https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (Publishable Key / anon key) de Supabase sujeta a políticas RLS
# (Project Settings -> API -> Publishable key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL base de la aplicación (usada para callbacks de autenticación y metadatos)
# En desarrollo local: http://localhost:3000
# En producción (Vercel): https://tu-dominio.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
